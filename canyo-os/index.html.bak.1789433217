  <meta name="theme-color" content="#f4f5f9" media="(prefers-color-scheme: light)">
  <link rel="alternate" hreflang="en-US" href="https://canyo.net/canyo-os/">
  <link rel="alternate" hreflang="x-default" href="https://canyo.net/canyo-os/">

  <!-- Structured data -->
  <script type="application/ld+json">
