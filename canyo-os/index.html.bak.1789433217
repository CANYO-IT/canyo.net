  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://canyo.net/canyo-os/">
  <meta name="twitter:title" content="CANYO OS — The First Self-Verifying Operating Layer for Business IT">
  <meta name="twitter:description" content="A signed, policy-bound control plane that maintains a known-good state on every machine — and proves it.">
  <meta name="twitter:image" content="https://canyo.net/assets/og-image.png">

  <!-- Canonical + robots -->
  <link rel="canonical" href="https://canyo.net/canyo-os/">
