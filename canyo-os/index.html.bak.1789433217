        "description": "CANYO OS is the industry's first self-verifying operating layer for business IT: a signed, policy-driven control plane that observes, decides, verifies, and proves every action on your machines.",
        "isPartOf": {"@id": "https://canyo.net/#website"},
        "about": {"@id": "https://canyo.net/#organization"},
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
