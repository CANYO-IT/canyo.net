<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CANYO OS — The First Self-Verifying Operating Layer for Business IT</title>
  <meta name="description" content="CANYO OS is the industry's first self-verifying operating layer for business IT: a signed, policy-driven control plane that observes, decides, verifies, and proves every action on your machines — then shows you the receipt.">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
