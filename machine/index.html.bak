/* idle */
let idleT;
function resetIdle(){clearTimeout(idleT);$('#idle').style.display='none';
  idleT=setTimeout(()=>{$('#idle').style.display='flex';log('OPERATOR IDLE');},30000);}
['pointermove','pointerdown','keydown','scroll'].forEach(e=>addEventListener(e,resetIdle,{passive:true}));
