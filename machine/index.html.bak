/* diagnostic: click the mark 5x */
var dgN=0,dgT;
$('#hudMark').addEventListener('click',()=>{
  clearTimeout(dgT);dgT=setTimeout(()=>dgN=0,900);dgN++;blip(300+dgN*60,.03);
  if(dgN>=5){dgN=0;var on=document.body.classList.toggle('diag');
    if(on){log('DIAGNOSTIC MODE','warn');document.body.style.filter='contrast(1.25) saturate(0)';
      log('LAYOUT · COMPONENTS · EVENTS · NETWORK · RENDER · MEMORY');}
    else{log('DIAGNOSTIC OFF','ok');document.body.style.filter='';}}
});
addEventListener('keydown',e=>{if(e.key==='d'){clearTimeout(dgT);dgT=setTimeout(()=>dgN=0,900);dgN++;
  if(dgN>=5){dgN=0;$('#hudMark').click();}}});


/* ================= INPUT ROUTER ================= */
const ORDER=['s1','s2','s3','s5','s6','s7','sF'];
function goTo(id){
  if(id===curSec)return;
  const from=document.getElementById(curSec);
  if(from){from.classList.add('leaving');setTimeout(()=>from.classList.remove('leaving'),500);}
  curSec=id;showSec(id);onEnter(id);blip(300+ORDER.indexOf(id)*40,.03);
}
let navLock=false;
function nav(dir){
  if(!document.body.classList.contains('ready'))return;
  if($('#shiftEnd').classList.contains('on'))return;
  if(curSec==='s2'){ // consume for word morph
    if(dir>0&&loopI<WORDS.length-1){if(!morphLock){morphLock=true;setTimeout(()=>morphLock=false,600);loopI++;morphWord();}return;}
    if(dir<0&&loopI>0){if(!morphLock){morphLock=true;setTimeout(()=>morphLock=false,600);loopI--;morphWord();}return;}
  }
  if(curSec==='s3')return; // wheel zooms the network there
  if(navLock)return;navLock=true;setTimeout(()=>navLock=false,700);
  const i=ORDER.indexOf(curSec)+dir;
  if(i>=0&&i<ORDER.length)goTo(ORDER[i]);
}
addEventListener('wheel',e=>{
  if(curSec==='s3')return; // canvas zoom handles it
  if(Math.abs(e.deltaY)<10)return;
  nav(e.deltaY>0?1:-1);
},{passive:true});
addEventListener('keydown',e=>{
  if(e.key==='ArrowDown'||e.key==='ArrowRight'||e.key==='PageDown'){nav(1);}
  else if(e.key==='ArrowUp'||e.key==='ArrowLeft'||e.key==='PageUp'){nav(-1);}
  else if(e.key==='Home'){goTo('s1');}
  else if(e.key==='End'){goTo('sF');}
});
/* swipe */
let swipeY=null;
addEventListener('touchstart',e=>{if(e.touches.length===1)swipeY=e.touches[0].clientY;},{passive:true});
addEventListener('touchend',e=>{
  if(swipeY===null)return;
  const dy=swipeY-e.changedTouches[0].clientY;swipeY=null;
  if(Math.abs(dy)<50)return;
  if(curSec==='s3')return; // canvas pinch/drag owns touch
  nav(dy>0?1:-1);
},{passive:true});
/* number keys = rail shortcuts */
addEventListener('keydown',e=>{
  const n=parseInt(e.key,10);
  if(n>=1&&n<=ORDER.length&&!e.metaKey&&!e.ctrlKey)goTo(ORDER[n-1]);
});



/* ================= MISSIONS ENGINE ================= */
const MISSIONS=[
 {id:'first',k:'01',dif:'easy',title:'FIRST DAY',desc:'Learn the console. Handle whatever comes through the queue.',objText:'RESOLVE 5 INCIDENTS',goal:{type:'res',n:5},pool:null,hp:100,dur:0},
 {id:'phish',k:'02',dif:'easy',title:'PHISHING SEASON',desc:'Someone is blasting the client with fake invoices and password resets.',objText:'RESOLVE 5 EMAIL THREATS',goal:{type:'tag',tag:'email',n:5},pool:'email',hp:100,dur:0},
 {id:'patch',k:'03',dif:'easy',title:'PATCH TUESDAY',desc:'A critical CVE dropped. The whole fleet needs updates before end of day.',objText:'DEPLOY 6 PATCHES',goal:{type:'tag',tag:'patch',n:6},pool:'patch',hp:100,dur:0},
 {id:'ransom',k:'04',dif:'hard',title:'RANSOMWARE DRILL',desc:'A simulated locker is loose on the network. Contain every ignition fast.',objText:'CONTAIN 3 LOCKERS · DON\'T MISS ANY',goal:{type:'tag',tag:'locker',n:3},pool:'locker',hp:80,dur:0},
 {id:'backup',k:'05',dif:'med',title:'BACKUP AUDIT',desc:'Quarterly verification. Snapshots must be recent, intact, and restorable.',objText:'VERIFY 5 BACKUP CHAINS',goal:{type:'tag',tag:'backup',n:5},pool:'backup',hp:100,dur:0},
 {id:'monday',k:'06',dif:'med',title:'MONDAY MORNING',desc:'The weekend built a ticket mountain. Clear the queue without letting it overflow.',objText:'RESOLVE 8 · NEVER LET 2 QUEUE UP',goal:{type:'res',n:8},pool:null,hp:90,dur:0},
 {id:'intern',k:'07',dif:'med',title:'THE INTERN CLICKED EVERYTHING',desc:'USER_07 had a busy afternoon. The AI keeps flagging their machine.',objText:'HANDLE 6 USER INCIDENTS',goal:{type:'tag',tag:'user',n:6},pool:'user',hp:90,dur:0},
 {id:'audit',k:'08',dif:'med',title:'COMPLIANCE AUDIT',desc:'Auditors want attestations and access reviews. These need a human signature.',objText:'ESCALATE 4 COMPLIANCE ITEMS CORRECTLY',goal:{type:'esc',n:4},pool:'human',hp:100,dur:0},
 {id:'zeroday',k:'09',dif:'hard',title:'ZERO-DAY',desc:'Everything is on fire and the queue won\'t stop. This is the job some weeks.',objText:'SURVIVE 90 SECONDS',goal:{type:'survive',n:90},pool:null,hp:60,dur:90,fast:1},
 {id:'quiet',k:'10',dif:'easy',title:'THE QUIET DAY',desc:'No alerts. Just you, the dashboards, and the hum. Rare. Enjoy it.',objText:'IDLE 45 SECONDS · TOUCH NOTHING',goal:{type:'idle',n:45},pool:'none',hp:100,dur:0}
];
// tag incidents so missions can filter pools
const INC_TAGS={};
function tagInc(){ // assign tags by keyword
  INCIDENTS.forEach(i=>{
    const t=(i.title+' '+i.desc).toLowerCase();
    i.tag = /ransomware|locker|scramble/.test(t)?'locker'
      : /phish|email|invoice|link/.test(t)?'email'
      : /update|patch|cve/.test(t)?'patch'
      : /backup|snapshot/.test(t)?'backup'
      : /compliance|audit|hipaa|vendor|admin access|judgment/.test(t)?'human'
      : /employee|user|intern|laptop/.test(t)?'user'
      : 'general';
  });
}
let M=null; // active mission
const LS_KEY='canyo_machine_stars';
function getStars(){try{return JSON.parse(localStorage.getItem(LS_KEY)||'{}');}catch(e){return{};}}
function setStar(id,g){const st=getStars();const rank={S:4,A:3,B:2,C:1,D:0,F:0};
  if(!st[id]||rank[g]>rank[st[id]]){st[id]=g;try{localStorage.setItem(LS_KEY,JSON.stringify(st));}catch(e){}}}

function openMissions(){ $('#missions').classList.add('on'); renderMissions(); blip(420,.05); }
function closeMissions(){ $('#missions').classList.remove('on'); }
function renderMissions(){
  const g=$g('mgrid');g.innerHTML='';const stars=getStars();
  MISSIONS.forEach(m=>{
    const st=stars[m.id];
    const b=document.createElement('button');b.className='mcard';b.dataset.cur='DEPLOY';
    b.innerHTML='<div class="mdif '+m.dif+'">'+m.dif.toUpperCase()+'</div>'+
      '<div class="mk">OBJECTIVE '+m.k+'</div>'+
      '<h3>'+m.title+'</h3>'+
      '<p>'+m.desc+'</p>'+
      '<div class="mobj">▸ '+m.objText+'</div>'+
      (st?'<div class="mstars">CLEARED · GRADE '+st+'</div>':'');
    b.addEventListener('click',()=>{closeMissions();startShift(m);});
    g.appendChild(b);
  });
}
function missionPool(m){
  if(m.pool==='none')return [];
  if(!m.pool)return INCIDENTS;
  const f=INCIDENTS.filter(i=>i.tag===m.pool);
  return f.length?f:INCIDENTS;
}
function objProgress(){ if(!M)return 0;
  const g=M.goal;
  if(g.type==='res')return G.res/g.n;
  if(g.type==='esc')return G.esc/g.n;
  if(g.type==='tag')return (G.tagHits||0)/g.n;
  if(g.type==='survive')return Math.min(1,(Date.now()-G.startT)/(g.n*1000));
  if(g.type==='idle')return Math.min(1,(G.idleT||0)/g.n);
  return 0;}
function objTick(){ if(!M||!G.on)return;
  const p=Math.min(1,objProgress());
  $g('objBarFill').style.transform='scaleX('+p+')';
  // friendly "2 / 5 done" count
  var cnt=$g('objCount');
  if(cnt){var g=M.goal,cur=0,tot=g.n;
    if(g.type==='res')cur=G.res; else if(g.type==='esc')cur=G.esc; else if(g.type==='tag')cur=G.tagHits||0;
    else if(g.type==='survive')cur=Math.min(g.n,Math.floor((Date.now()-G.startT)/1000));
    else if(g.type==='idle')cur=Math.min(g.n,Math.floor(G.idleT||0));
    cnt.textContent=' · '+Math.floor(cur)+' / '+tot+(p>=1?' ✓':'');
  }
  // idle mission accrues time when no incident open
  if(M.goal.type==='idle'&&!G.active){G.idleT=(G.idleT||0)+0.5;}
  if(p>=1)missionComplete();
}
function missionComplete(){ endShift(false,true); M=null; }

/* ================= GAME: SHIFT ================= */
const INCIDENTS=[
 // ---- AUTO-FIXABLE (machine handles safely) ----
 {sev:'CRITICAL',auto:1,tag:'locker',title:'RANSOMWARE NOTE FOUND',plain:'A file that scrambles your data just appeared on the file server.',ai:'This is a real threat. I can lock it down and clean it up safely on my own.',script:['> spot the bad file','> freeze the server so it can\'t spread','> delete the threat','> restore the clean copy from backup','[OK] THREAT GONE · FILES SAFE']},
 {sev:'LOW',auto:1,tag:'patch',title:'SECURITY UPDATE READY',plain:'3 computers are missing an important safety update.',ai:'Easy fix. I\'ll install it quietly tonight so nobody is interrupted.',script:['> queue the update for 3 computers','> install silently after hours','[OK] ALL UPDATED · NO RESTART NEEDED']},
 {sev:'MEDIUM',auto:1,tag:'disk',title:'SERVER ALMOST FULL',plain:'A server\'s storage is 91% full — it will stop working soon.',ai:'I\'ll clean out old logs and free up space automatically.',script:['> compress old logs','> delete files older than 30 days','[OK] 41 GB FREED UP']},
 {sev:'LOW',auto:1,tag:'backup',title:'BACKUP IS OVERDUE',plain:'One computer hasn\'t backed up its files in over a day.',ai:'The backup tool got stuck. Restarting it and forcing a fresh backup now.',script:['> restart the backup tool','> run a fresh backup','> confirm the copy opens correctly','[OK] BACKUP COMPLETE · VERIFIED']},
 {sev:'CRITICAL',auto:1,tag:'cert',title:'SECURITY CERTIFICATE EXPIRES IN 2 DAYS',plain:'The digital "ID card" for your connection is about to expire — things would break.',ai:'I renew these automatically before they expire. Handled.',script:['> request a fresh certificate','> install it + reload the connection','[OK] VALID FOR 90 MORE DAYS']},
 {sev:'MEDIUM',auto:1,tag:'device',title:'UNKNOWN DEVICE ON THE NETWORK',plain:'Something plugged into your network that we don\'t recognize.',ai:'I\'ll figure out what it is and wall it off from your real systems until we know it\'s safe.',script:['> identify the device','> move it to a safe guest zone','[OK] IDENTIFIED · KEPT AWAY FROM YOUR DATA']},
 {sev:'LOW',auto:1,tag:'memory',title:'PRINT SYSTEM SLOWING DOWN',plain:'The print system is gradually eating up memory and will crash.',ai:'A quick restart fixes it. I\'ll also flag the buggy driver to prevent it next time.',script:['> restart the print system','> flag the buggy driver','[OK] RUNNING NORMALLY']},
 {sev:'MEDIUM',auto:1,tag:'drift',title:'SETTINGS CHANGED UNEXPECTEDLY',plain:'Your firewall settings drifted from the safe baseline we set.',ai:'Someone or something changed a rule. I\'m putting it back to the known-good state.',script:['> compare current settings to baseline','> restore the 2 changed rules','[OK] BACK TO SAFE STATE']},
 // ---- NEED A HUMAN (out of AI scope) ----
 {sev:'CRITICAL',auto:0,tag:'human',title:'EMPLOYEE\'S LAPTOP ACTING STRANGE',plain:'Someone\'s screen flashed and files got renamed while they were using it.',ai:'This is actively happening and a person is mid-work. Saving their files while containing it needs a human on the phone — beyond what I should do alone.',escalate:'Escalated to the on-call engineer. The laptop was isolated, file copies frozen, and the user was walked through it by phone.'},
 {sev:'CRITICAL',auto:0,tag:'human',title:'COMPLIANCE AUDIT REQUESTED',plain:'Your client needs a signed HIPAA access review by Friday.',ai:'A legal document that a real person must review and sign. I can\'t certify compliance — but I\'ve gathered all the evidence.',escalate:'Sent to Samuel. The evidence bundle was pre-generated and attached to the ticket.'},
 {sev:'MEDIUM',auto:0,tag:'human',title:'SOFTWARE VENDOR SHUTTING DOWN',plain:'A tool your business relies on is being discontinued in 30 days.',ai:'Switching tools affects your budget and how your team works. That\'s a business decision for you, not me.',escalate:'Escalated with a plain-English impact summary and three migration options for you to choose from.'},
 {sev:'LOW',auto:0,tag:'human',title:'EMPLOYEE WANTS ADMIN ACCESS',plain:'Someone asked for full control of their computer to install a tool.',ai:'Granting this could expose you, but blocking it might stop their work. This is a judgment call for a human.',escalate:'Escalated for approval. Suggested giving temporary, time-limited access instead of full control.'}
];
const G={on:false,hp:100,res:0,esc:0,mis:0,active:null,timer:null,tLeft:0,tMax:15,spawnT:null,termIv:null,startT:0,dur:120};
const $g=id=>document.getElementById(id);

function gLog(m,c){log(m,c);}
function setHP(v){G.hp=Math.max(0,Math.min(100,Math.round(v)));
  const f=$g('healthFill');f.style.transform='scaleX('+G.hp/100+')';
  f.classList.toggle('low',G.hp<40);document.body.classList.toggle('lowhp',G.hp<40&&G.on);$g('hudHealth').textContent=G.hp+'%';}
function score(){['gRes','gEsc','gMis'].forEach((id,i)=>{$g(id).textContent=[G.res,G.esc,G.mis][i];});}

function startShift(mission){
  M=mission||null;G.lastM=M;G.tagHits=0;G.idleT=0;
  G.on=true;G.hp=100;G.res=0;G.esc=0;G.mis=0;G.startT=Date.now();
  if(M){G.hp=M.hp;G.dur=M.dur||0;}else{G.dur=120;}
  setHP(G.hp);score();$g('shiftEnd').classList.remove('on');
  $g('gameBtn').innerHTML='&#9632; END SHIFT';
  // objective banner
  if(M){$g('objText').innerHTML='<b>'+M.title+'</b> · '+M.objText;
    $g('objBanner').classList.add('on');$g('objBarFill').style.transform='scaleX(0)';
    gLog('OBJECTIVE: '+M.title+' — '+M.objText,'ok');
  }else{$g('objBanner').classList.remove('on');gLog('SHIFT STARTED — FLEET UNDER YOUR WATCH','ok');}
  blip(520,.12);
  scheduleSpawn(1800);
  if(M&&M.goal.type==='idle'){ /* quiet day: no spawns */ }
  // objective ticker
  clearInterval(G.objIv);G.objIv=setInterval(objTick,500);
  G.hpIv=setInterval(()=>{ if(!G.on)return;
    setHP(G.hp+ (G.active?0:0.4)); // slow regen when idle
    if(G.hp<=0)endShift(true);
  },1200);
  clearInterval(G.clockIv);if(G.dur>0)G.clockIv=setInterval(()=>{ if(G.on && Date.now()-G.startT>G.dur*1000)endShift(false);},1000);
}
function endShift(failed,won){
  if(!G.on)return; G.on=false;clearTimeout(G.spawnT);clearInterval(G.hpIv);clearInterval(G.clockIv);clearInterval(G.objIv);
  $g('objBanner').classList.remove('on');
  clearIncident(true);
  const total=G.res+G.esc+G.mis, handled=G.res+G.esc;
  let grade='C';
  const acc=total?handled/total:0, h=G.hp;
  if(failed)grade='F';
  else if(acc>.92&&h>85)grade='S';
  else if(acc>.85&&h>70)grade='A';
  else if(acc>.7&&h>50)grade='B';
  else if(acc>.5)grade='C'; else grade='D';
  $g('seGrade').textContent=grade;
  $g('seTitle').textContent=failed?'FLEET COMPROMISED':(won?'OBJECTIVE COMPLETE':'SHIFT COMPLETE');
  $g('seGrade').style.color=failed?'var(--warn)':(grade==='S'||grade==='A'?'var(--ok)':'var(--ink)');
  $g('seRep').innerHTML=
    (M||arguments&&G.lastM?'<div style="color:var(--acc);letter-spacing:.2em;font-size:9px;margin-bottom:8px">'+(G.lastM?G.lastM.title:'')+'</div>':'')+
    'RESOLVED BY SCRIPT <b>'+G.res+'</b><br>ESCALATED TO HUMAN <b>'+G.esc+'</b><br>MISSED / TIMED OUT <b>'+G.mis+'</b><br>FINAL INTEGRITY <b>'+G.hp+'%</b><br>ACCURACY <b>'+Math.round(acc*100)+'%</b>';
  if(G.lastM&&!failed){setStar(G.lastM.id,grade);}
  $g('shiftEnd').classList.add('on');
  $g('gameBtn').innerHTML='&#9654; START SHIFT';
  gLog(failed?'SHIFT FAILED':'SHIFT COMPLETE — GRADE '+grade, failed?'warn':'ok');
  blip(failed?120:680,.3,failed?'sawtooth':'square',.08);
}
function scheduleSpawn(d){clearTimeout(G.spawnT);if(!G.on)return;
  const fast=M&&M.fast;
  G.spawnT=setTimeout(spawnIncident,d||(fast?rnd(2200,4200):rnd(6000,11000)));}
function spawnIncident(){
  if(!G.on||G.active){scheduleSpawn(3000);return;}
  if(M&&M.pool==='none'){scheduleSpawn(4000);return;} // quiet day
  if(!INCIDENTS[0].tag)tagInc();
  let pool=M?missionPool(M):INCIDENTS;
  if(M&&M.pool&&M.pool!=='none'){ // bias to mission pool but sprinkle general
    pool=Math.random()<.75?missionPool(M):INCIDENTS;
  }
  const inc=pick(pool);G.active=inc;
  G.tMax=inc.sev==='CRITICAL'?10:inc.sev==='MEDIUM'?15:20;G.tLeft=G.tMax;
  $g('incSev').textContent=inc.sev;$g('incSev').className='sev '+inc.sev;
  $g('incTitle').textContent=inc.title;
  $g('incDesc').textContent=inc.plain||inc.desc;
  var plainMap={CRITICAL:'serious — act fast',MEDIUM:'needs attention',LOW:'minor'};
  var pl=$g('incPlain');if(pl)pl.textContent=plainMap[inc.sev]||'';
  $g('incAi').textContent=''; // typewriter
  $g('inc').classList.add('on');$g('inc').classList.toggle('crit',inc.sev==='CRITICAL');
  typeInto($g('incAi'),'AI ▸ '+inc.ai);
  gLog(inc.sev+': '+inc.title, inc.sev==='CRITICAL'?'warn':'');
  blip(inc.sev==='CRITICAL'?220:440,.08,'square',.06);
  // countdown
  const fill=$g('incTimerFill');const t0=Date.now();
  clearInterval(G.timer);
  G.timer=setInterval(()=>{
    const el=(Date.now()-t0)/1000;G.tLeft=G.tMax-el;
    fill.style.transform='scaleX('+Math.max(0,G.tLeft/G.tMax)+')';
    setHP(G.hp-(inc.sev==='CRITICAL'?.5:.25)); // drain while open
    if(G.tLeft<=0){missIncident();}
  },100);
}
function typeInto(el,txt){let i=0;el.textContent='';
  clearInterval(G.typeIv);G.typeIv=setInterval(()=>{el.textContent=txt.slice(0,++i);
    if(i>=txt.length)clearInterval(G.typeIv);},14);}
function noteResolve(inc,wasEsc){ if(!inc)return;
  if(M){ if(M.goal.type==='tag'&&inc.tag===M.goal.tag)G.tagHits=(G.tagHits||0)+1;
    if(M.goal.type==='res'){/* G.res already counts */}
    if(M.goal.type==='esc'&&wasEsc){/* G.esc counts */} } }
function clearIncident(silent){clearInterval(G.timer);clearInterval(G.typeIv);
  $g('inc').classList.remove('on');$g('inc').classList.remove('crit');if(!silent)G.active=null;}
function missIncident(){const inc=G.active;clearIncident();G.mis++;score();
  setHP(G.hp-(inc.sev==='CRITICAL'?25:inc.sev==='MEDIUM'?14:8));
  gLog('MISSED: '+inc.title,'warn');blip(140,.2,'sawtooth',.07);bumpCombo(false);shake();scheduleSpawn();}

function runTerm(lines,done){
  const t=$g('term');t.classList.add('on');
  t.innerHTML='<div class="tl dim" style="color:var(--ink-faint);margin-bottom:4px">HOW CANYO FIXES IT — DETECT · ISOLATE · FIX · VERIFY · LOG</div>';
  let i=0;clearInterval(G.termIv);
  G.termIv=setInterval(()=>{
    if(i>=lines.length){clearInterval(G.termIv);
      setTimeout(()=>{t.classList.remove('on');done&&done();},700);return;}
    const L=lines[i];const div=document.createElement('div');div.className='tl';
    if(L.startsWith('[OK]')||L.startsWith('[DONE]'))div.classList.add('ok2');
    else if(L.startsWith('[FAIL]')||L.startsWith('[WARN]'))div.classList.add('warn2');
    else if(L.startsWith('['))div.classList.add('dim');
    else div.classList.add('dim');
    div.textContent=L;t.appendChild(div);
    blip(600+i*40,.015,'square',.03);i++;
  },260);
}

/* decisions */
$g('incRun').addEventListener('click',()=>{
  const inc=G.active;if(!inc)return;
  if(inc.auto){ // in-scope: script works
    clearIncident();G.res++;score();setHP(G.hp+4);
    runTerm(inc.script,()=>{noteResolve(inc,false);gLog('RESOLVED: '+inc.title,'ok');blip(760,.1,'square',.07);bumpCombo(true);scheduleSpawn();});
  }else{ // out of scope: script fails, AI escalates on its own
    G.res++; // attempted; count handled
    runTerm(['> canyo-autofix --attempt','> probing...','[WARN] COMPLEXITY ABOVE AUTO-REMEDIATION THRESHOLD','[FAIL] OUT OF AI SCOPE'],()=>{
      setHP(G.hp-4);
      gLog('AI REALIZED: OUT OF SCOPE — ESCALATING','warn');shake();
      typeEscalate(inc); // keep toast, show escalation
    });
  }
});
$g('incAuto').addEventListener('click',()=>{
  const inc=G.active;if(!inc)return;
  if(inc.auto){clearIncident();G.res++;score();setHP(G.hp+4);
    runTerm(['> auto-remediate (policy)'].concat(inc.script),()=>{noteResolve(inc,false);gLog('AUTO-RESOLVED: '+inc.title,'ok');blip(720,.09);scheduleSpawn();});
  }else{clearIncident();G.res++;score();
    runTerm(['> auto-triage','[WARN] NEEDS HUMAN JUDGMENT'],()=>{typeEscalate(inc);});}
});
$g('incEsc').addEventListener('click',()=>{
  const inc=G.active;if(!inc)return;
  if(!inc.auto){clearIncident();G.esc++;score();setHP(G.hp+2);noteResolve(inc,true);
    gLog('ESCALATED: '+inc.title,'ok');blip(500,.08);
    flashNote('HANDED TO HUMAN',inc.escalate);scheduleSpawn();
  }else{clearIncident();G.esc++;score();setHP(G.hp-3);
    gLog('ESCALATED (COULD HAVE AUTO-FIXED): '+inc.title);
    flashNote('OVER-ESCALATED','This was auto-remediable. The human billed you for a patch.');scheduleSpawn();}
});
function typeEscalate(inc){ // AI escalates itself after failed attempt
  G.active=null; // consumed
  gLog('AI ESCALATED: '+inc.title,'warn');
  flashNote('AI ESCALATED TO HUMAN',inc.escalate);
  $g('inc').classList.remove('on');scheduleSpawn();
}
function flashNote(title,body){ // transient center note
  const n=document.createElement('div');
  n.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:120;background:var(--bg2);border:1px solid var(--line2);border-left:3px solid var(--acc);padding:18px 22px;font-family:var(--fm);max-width:min(400px,90vw)';
  n.innerHTML='<div style="font-size:9px;letter-spacing:.22em;color:var(--acc);margin-bottom:6px">'+title+'</div><div style="font-size:10px;line-height:1.6;color:var(--ink-dim)">'+body+'</div>';
  document.body.appendChild(n);
  setTimeout(()=>{n.style.transition='opacity .5s';n.style.opacity=0;setTimeout(()=>n.remove(),520);},2600);
}

/* game button */
$g('gameBtn').addEventListener('click',()=>{ if(G.on)endShift(false); else openMissions(); });
$g('seAgain').addEventListener('click',()=>startShift(G.lastM||null));
$g('seExit').addEventListener('click',()=>{$g('shiftEnd').classList.remove('on');});
$g('mclose').addEventListener('click',closeMissions);
addEventListener('keydown',e=>{ if(e.key==='Escape'){ closeMissions(); $g('shiftEnd').classList.remove('on'); } });
setHP(100);

/* keyboard: R=run script, A=auto, E=escalate, SPACE=start/end shift */
addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey)return;
  const k=e.key.toLowerCase();
  if($('#shiftEnd').classList.contains('on')){ if(k==='enter')startShift(); return; }
  if(k===' '){ e.preventDefault(); if(G.on)endShift(false); else openMissions(); return; }
  if(!G.active)return;
  if(k==='r')$g('incRun').click();
  else if(k==='a')$g('incAuto').click();
  else if(k==='e')$g('incEsc').click();
});

/* combo tracking */
let combo=0,comboT;
function bumpCombo(good){
  combo=good?combo+1:0;
  const el=$g('combo');
  if(combo>=2){el.innerHTML='COMBO<b>x'+combo+'</b>';el.classList.add('on');
    clearTimeout(comboT);comboT=setTimeout(()=>el.classList.remove('on'),1500);}
  else el.classList.remove('on');
}
function shake(){document.body.classList.add('shake');setTimeout(()=>document.body.classList.remove('shake'),420);}

/* ================= FINAL ================= */
function enterFinal(){document.body.className='';chaos=1;worseN=0;$('#optReadout').textContent='SYSTEM OPTIMIZATION: 100%';}
$('#returnBtn').addEventListener('click',()=>{blip(520,.1);location.href='../';});

/* ================= MASTER LOOP ================= */
function sizeAll(){[bn,mc,$('#loopCanvas')].forEach(c=>{if(c){c.width=W;c.height=H;}});}
sizeAll();buildNodes();buildNet();
(function frame(){
  if(curSec==='s1')tickNodes();
  if(curSec==='s3')tickNet();
  if(curSec==='s7')tickMap();
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
